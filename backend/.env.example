# ==============================
# Al-Rayan Store — Backend Config
# ==============================

# Server
PORT=8001

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alrayan_store

# JWT (غيّر هذا في الإنتاج)
JWT_SECRET=please-change-me-to-a-long-random-string

# الأدمن (يُنشأ تلقائياً عند تشغيل init-db)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=alrayan2026

# WhatsApp number (بدون + و بدون مسافات. مثال للكويت: 96599999999)
WHATSAPP_NUMBER=96599999999

# CORS — رابط الواجهة الذي سيتصل بالـ API (* للسماح للجميع، أو https://yourdomain.com)
CORS_ORIGIN=*

# Public Base URL — يُستخدم لإرجاع روابط الصور المرفوعة (بدون / في الآخر)
# اتركه فارغاً ليُستخدم نفس domain الباك إند
PUBLIC_BASE_URL=
